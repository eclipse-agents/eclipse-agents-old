Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: ModelContextProtocol
Bundle-SymbolicName: org.eclipse.agents.contexts;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: org.eclipse.agents.contexts.Activator
Eclipse-BundleShape: dir
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.ui,
 org.eclipse.jface,
 org.eclipse.agents;bundle-version="1.0.0",
 com.fasterxml.jackson.core.jackson-annotations;bundle-version="2.17.2",
 com.fasterxml.jackson.core.jackson-databind;bundle-version="2.17.2",
 com.fasterxml.jackson.core.jackson-core;bundle-version="2.17.2",
 org.eclipse.core.filesystem,
 org.eclipse.core.resources,
 org.eclipse.ui.workbench,
 org.eclipse.ui.console,
 org.eclipse.ui.ide,
 org.eclipse.jface.text,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.compare,
 org.eclipse.swt,
 org.eclipse.ui.editors,
 org.eclipse.lsp4j.jsonrpc;bundle-version="0.24.0",
 com.google.gson;bundle-version="2.13.1",
 org.eclipse.ui.navigator,
 org.eclipse.jetty.ee10.servlet;bundle-version="12.1.0",
 org.eclipse.jetty.server;bundle-version="12.1.0",
 org.eclipse.jetty.util;bundle-version="12.1.0",
 org.eclipse.wildwebdeveloper.embedder.node
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: org.eclipse.mcp
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .,
 lib/classmate-1.7.1.jar,
 lib/jackson-datatype-jsr310-2.20.0.jar,
 lib/jsonschema-generator-4.38.0.jar,
 lib/jsonschema-module-jackson-4.38.0.jar,
 lib/jsonschema-module-swagger-2-4.38.0.jar,
 lib/json-schema-validator-1.5.9.jar,
 lib/jsr305-3.0.2.jar,
 lib/reactive-streams-1.0.4.jar,
 lib/reactor-core-3.7.12.jar,
 lib/reactor-stream-2.0.8.RELEASE.jar,
 lib/swagger-annotations-2.2.39.jar,
 lib/slf4j-api-2.0.16.jar
Import-Package: jakarta.servlet;version="6.1.0",
 jakarta.servlet.annotation;version="[6.1.0,7.0.0)",
 jakarta.servlet.http;version="[6.1.0,7.0.0)",
 org.springaicommunity.mcp.provider.complete
Export-Package: org.eclipse.agents.contexts;uses:="org.eclipse.core.runtime,org.eclipse.ui.dialogs,org.eclipse.jface.dialogs",
 org.eclipse.agents.contexts.internal;x-friends:="org.eclipse.mcp.builtins,org.eclipse.mcp.test,org.eclipse.mcp.test",
 org.eclipse.agents.contexts.internal.preferences;x-friends:="org.eclipse.mcp.test",
 org.eclipse.agents.contexts.platform,
 org.eclipse.agents.contexts.platform.resource
